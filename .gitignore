# ==============================================================================
# Impulse Guard - Git Ignore Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Data & Datasets (Audio files, raw datasets, mixtures, labels, features)
# ------------------------------------------------------------------------------
data/
dataset/
datasets/

# Audio formats (prevent accidental commit of audio files anywhere in repo)
*.wav
*.mp3
*.flac
*.ogg
*.opus
*.m4a
*.aac
*.wma
*.aiff
*.sph
*.pcm
*.raw

# Numerical data, feature matrices, and cached tensors
*.npy
*.npz
*.h5
*.hdf5
*.parquet
*.feather
*.arrow
*.tfrecord

# Dataset archives and compressed dumps
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.rar
*.gz
*.bz2

# ------------------------------------------------------------------------------
# 2. Machine Learning Models, Checkpoints & Weights
# ------------------------------------------------------------------------------
checkpoints/
models/**/*.pt
models/**/*.pth
models/**/*.ckpt
models/**/*.onnx
models/**/*.tflite
models/**/*.bin
models/**/*.weights
models/**/*.pb
models/**/*.engine
models/**/*.safetensors
models/**/*.h5

# Global model binary formats
*.pt
*.pth
*.ckpt
*.onnx
*.tflite
*.weights
*.engine
*.safetensors

# ------------------------------------------------------------------------------
# 3. Experiment Results, Benchmarks & Generated Outputs
# ------------------------------------------------------------------------------
results/
runs/
wandb/
lightning_logs/
tensorboard/
*.log
tree.txt

# ------------------------------------------------------------------------------
# 4. Environment Variables & Sensitive Credentials
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.template
*.env
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
credentials.json
secrets.json
token.json

# ------------------------------------------------------------------------------
# 5. Python Virtual Environments & Bytecode Caches
# ------------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
site-packages/

# Bytecode & C extensions
__pycache__/
*.py[cod]
*$py.class
*.so

# Python distribution / packaging artifacts
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# 6. Testing, Linting & Coverage
# ------------------------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# ------------------------------------------------------------------------------
# 7. Jupyter Notebooks
# ------------------------------------------------------------------------------
.ipynb_checkpoints/
*-checkpoint.ipynb
*.nbconvert/

# ------------------------------------------------------------------------------
# 8. Embedded / Firmware (ESP32 & PlatformIO)
# ------------------------------------------------------------------------------
.pio/
.pioenvs/
.piolibdeps/
.clangd/
firmware/**/.pio/
firmware/**/build/
sdkconfig
sdkconfig.old
*.elf
*.hex
*.map
*.o
*.a
*.d

# ------------------------------------------------------------------------------
# 9. IDEs, Editors & Operating System Files
# ------------------------------------------------------------------------------
# VS Code (ignore workspace state and caches, allow shared configs)
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
*.code-workspace

# JetBrains / PyCharm
.idea/

# Editor temporary & backup files
*.swp

*.swo
*~
*.save
*.bak
*.orig

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary directories
[Tt]emp/
[Tt]mp/