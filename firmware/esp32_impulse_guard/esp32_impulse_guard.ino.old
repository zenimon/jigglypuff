#include <Arduino.h>
#include "driver/i2s_std.h"

// ================= PIN CONFIGURATION =================

#define SHARED_BCLK 15
#define SHARED_WS   16

#define MIC_SD      17

#define SAMPLE_RATE 16000
#define FRAME_SIZE  320

i2s_chan_handle_t rx_handle;

// ================= I2S SETUP =================

void startMicrophone() {

    i2s_chan_config_t chan_cfg =
        I2S_CHANNEL_DEFAULT_CONFIG(
            I2S_NUM_0,
            I2S_ROLE_MASTER
        );

    esp_err_t err = i2s_new_channel(
        &chan_cfg,
        NULL,
        &rx_handle
    );

    if (err != ESP_OK) {
        Serial.printf(
            "I2S CHANNEL ERROR: %d\n",
            err
        );
        while (1);
    }

    i2s_std_config_t std_cfg = {

        .clk_cfg =
            I2S_STD_CLK_DEFAULT_CONFIG(
                SAMPLE_RATE
            ),

        .slot_cfg =
            I2S_STD_PHILIPS_SLOT_DEFAULT_CONFIG(
                I2S_DATA_BIT_WIDTH_32BIT,
                I2S_SLOT_MODE_MONO
            ),

        .gpio_cfg = {
            .mclk = I2S_GPIO_UNUSED,

            .bclk =
                (gpio_num_t)SHARED_BCLK,

            .ws =
                (gpio_num_t)SHARED_WS,

            .dout =
                I2S_GPIO_UNUSED,

            .din =
                (gpio_num_t)MIC_SD,

            .invert_flags = {
                .mclk_inv = false,
                .bclk_inv = false,
                .ws_inv   = false
            }
        }
    };

    // INMP441 is connected to LEFT channel
    std_cfg.slot_cfg.slot_mask =
        I2S_STD_SLOT_LEFT;

    err = i2s_channel_init_std_mode(
        rx_handle,
        &std_cfg
    );

    if (err != ESP_OK) {
        Serial.printf(
            "I2S INIT ERROR: %d\n",
            err
        );
        while (1);
    }

    err = i2s_channel_enable(rx_handle);

    if (err != ESP_OK) {
        Serial.printf(
            "I2S ENABLE ERROR: %d\n",
            err
        );
        while (1);
    }

    Serial.println("I2S MICROPHONE INITIALIZED");
}


// ================= MICROPHONE TEST =================

void testMicrophone() {

    static int32_t raw_buffer[FRAME_SIZE];

    size_t bytes_read = 0;

    esp_err_t err = i2s_channel_read(
        rx_handle,
        raw_buffer,
        sizeof(raw_buffer),
        &bytes_read,
        portMAX_DELAY
    );

    if (err != ESP_OK) {

        Serial.printf(
            "I2S READ ERROR: %d\n",
            err
        );

        return;
    }

    int samples =
        bytes_read / sizeof(int32_t);

    int16_t min_value = 32767;
    int16_t max_value = -32768;

    uint64_t sum_abs = 0;

    for (int i = 0; i < samples; i++) {

        // INMP441 useful audio bits
        int32_t raw = raw_buffer[i];

        int16_t sample =
            (int16_t)(raw >> 14);

        if (sample < min_value)
            min_value = sample;

        if (sample > max_value)
            max_value = sample;

        sum_abs +=
            (sample >= 0)
                ? sample
                : -sample;
    }

    float mean_abs =
        (float)sum_abs / samples;

    Serial.printf(
        "samples=%d  min=%d  max=%d  mean_abs=%.2f\n",
        samples,
        min_value,
        max_value,
        mean_abs
    );
}


// ================= SETUP =================

void setup() {

    Serial.begin(115200);

    delay(2000);

    Serial.println();
    Serial.println(
        "================================"
    );
    Serial.println(
        " IMPULSE GUARD - INMP441 TEST"
    );
    Serial.println(
        "================================"
    );

    Serial.println(
        "BCLK : GPIO 15"
    );

    Serial.println(
        "WS   : GPIO 16"
    );

    Serial.println(
        "SD   : GPIO 17"
    );

    Serial.println(
        "Sample rate : 16000 Hz"
    );

    Serial.println(
        "Frame size  : 320"
    );

    Serial.println();

    startMicrophone();

    Serial.println(
        "Listening..."
    );
}


// ================= LOOP =================

void loop() {

    testMicrophone();

    delay(100);
}